rules_version = '2';
// Reglas de seguridad de la plataforma de proveedores (colecciones con prefijo pv_).
// Firebase > Firestore Database > Reglas > pegar este archivo > Publicar.
// Otras colecciones del proyecto no se ven afectadas y el navegador no puede leerlas.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return get(/databases/$(database)/documents/pv_admins/$(request.auth.uid)).data; }
    function isStaff() { return signedIn() && exists(/databases/$(database)/documents/pv_admins/$(request.auth.uid)) && me().activo == true; }
    function isAdmin() { return isStaff() && me().rol == 'admin'; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function prov(uid) { return get(/databases/$(database)/documents/pv_proveedores/$(uid)).data; }
    function editable(uid) { return prov(uid).estado in ['captura', 'correccion']; }
    // En «corrección» solo se reemplazan los documentos marcados (o los requeridos que falten).
    function canUpload(uid, tipo) {
      let p = prov(uid);
      return p.estado == 'captura' || (p.estado == 'correccion' && (!(tipo in p.entregados) ||
        (tipo in p.revisiones && p.revisiones[tipo].revision == 'correccion' && p.revisiones[tipo].version == p.entregados[tipo])));
    }

    // Marca de que existe el administrador principal (se crea una sola vez).
    match /pv_config/inicio {
      allow get: if true;
      allow create: if signedIn() && getAfter(/databases/$(database)/documents/pv_admins/$(request.auth.uid)).data.rol == 'admin';
    }

    match /pv_admins/{uid} {
      allow read: if isStaff() || isOwner(uid);
      allow create: if isAdmin() ||
        (isOwner(uid) && request.resource.data.rol == 'admin' && request.resource.data.activo == true &&
         !exists(/databases/$(database)/documents/pv_config/inicio) &&
         existsAfter(/databases/$(database)/documents/pv_config/inicio));
      allow update: if isAdmin() ||
        (isOwner(uid) && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['cambiar_clave', 'ultimo_acceso']));
    }

    // Folio -> correo de acceso: se consulta un folio concreto; solo el personal puede listar.
    match /pv_folios/{folio} {
      allow get: if true;
      allow list: if isStaff();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
    }

    match /pv_proveedores/{uid} {
      allow read: if isOwner(uid) || isStaff();
      allow create: if isOwner(uid) && request.resource.data.estado == 'captura' && request.resource.data.resultado == 'pendiente' &&
        request.resource.data.entregados.size() == 0 && request.resource.data.revisiones.size() == 0;
      allow update: if isStaff() || (isOwner(uid) && resource.data.estado in ['captura', 'correccion'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['datos', 'paso', 'actualizado_en', 'razon_social', 'pais',
          'contacto', 'correo', 'telefono', 'entregados', 'estado', 'envios', 'enviado_en', 'reenviado_en']) &&
        (request.resource.data.estado == resource.data.estado || request.resource.data.estado == 'enviado'));

      match /documentos/{docId} {
        allow read: if isOwner(uid) || isStaff();
        allow create: if isOwner(uid) && canUpload(uid, request.resource.data.tipo) && request.resource.data.proveedor_id == uid &&
          request.resource.data.revision == 'pendiente' && request.resource.data.vigente == true;
        allow update: if isStaff() || (isOwner(uid) && canUpload(uid, resource.data.tipo) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['vigente']) && request.resource.data.vigente == false);

        match /partes/{n} {
          allow read: if isOwner(uid) || isStaff();
          allow create: if isOwner(uid) && editable(uid) && request.resource.data.d is string && request.resource.data.d.size() <= 700000;
        }
      }

      match /historial/{id} {
        allow read: if isOwner(uid) || isStaff();
        allow create: if isStaff() || (isOwner(uid) && request.resource.data.actor_tipo == 'proveedor');
      }
    }

    // Tamaño total de documentos (pantalla Sistema).
    match /{path=**}/documentos/{docId} {
      allow read: if isStaff();
    }

    // Bitácora de correos: quien tiene sesión registra sus envíos; solo el personal la consulta.
    match /pv_correos/{id} {
      allow create: if signedIn();
      allow read, update: if isStaff();
    }

    // Destinatarios de las alertas internas (los lee el navegador que envía la alerta).
    match /pv_destinatarios/{id} {
      allow read: if signedIn();
      allow write: if isAdmin();
    }
  }
}
